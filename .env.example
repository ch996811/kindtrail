# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox test accounts (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_PERSONAL_EMAIL=

# AI review. gemini = live calls (falls back to cached answers when the daily cap is hit);
# replay = cached answers only, no key needed (demo receipts still work)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_DAILY_CAP=300
