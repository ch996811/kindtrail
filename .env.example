# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox). Leave empty to run without PayPal:
# pages, the AI review of the demo receipts and the rule engine still work; giving and paying out don't.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox personal account that plays the field partner and receives payouts
# (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_PERSONAL_EMAIL=
# Optional: the sandbox webhook's id, so incoming webhooks can be signature-verified
PAYPAL_WEBHOOK_ID=

# AI review. gemini = live calls (falls back to cached answers when the daily cap is hit);
# replay = cached answers only, no key needed (demo receipts still work)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_DAILY_CAP=300

# 1 = seed three made-up gifts ($95) so a request can be approved, and enable "Run the demo again"
DEMO_MODE=1
# Optional: where the SQLite file lives (default backend/kindtrail.db) and where the built frontend is
# DB_PATH=
# FRONTEND_DIST=
